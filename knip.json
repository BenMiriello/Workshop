{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/shoot.mjs"
      ],
      "project": [
        "scripts/*.mjs"
      ]
    },
    "frontend": {
      "entry": [
        "src/main.tsx",
        "vite.config.ts",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignore": [
        "src/api/schema.gen.ts"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/index.ts",
        "src/map.tsx",
        "src/markdown.tsx",
        "scripts/*.mjs",
        "src/styles/*.mjs",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx,mjs}"
      ]
    }
  },
  "ignoreDependencies": [
    ".*"
  ],
  "ignoreBinaries": [
    ".*"
  ]
}
