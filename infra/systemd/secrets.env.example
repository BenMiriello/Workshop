# Workshop secrets — copy to ~/.config/workshop/secrets.env and fill in.
# `scripts/install_service.sh` copies this here (mode 0600) if it does not exist.
# Do NOT commit the filled-in copy. Everything here is OPTIONAL: the backend
# starts without it, but the corresponding features stay dormant.
#
# PLATFORM SECRETS ONLY. An app's credentials are the app's to declare, in its
# own `apps/<slug>/secrets.env.example`, and the vars it must never leak into a
# spawned turn are named on its `AppSpec.secret_env`. This file used to carry a
# payments vendor's client id and secret, a transit API key, a wearables API
# key, an iMessage bridge and one app's target chat channel — platform source
# naming one operator's integrations, with defaults that were one machine's
# answer. Adding an app must not mean editing this file.

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Postgres (the platform's own database)
POSTGRES_PASSWORD=

# Auto-PR: set to 1 to enable real `gh pr create`; default dry-run
WORKSHOP_AUTO_PR=0

# Discord bot token — lets the backend deliver operator notifications directly
# (services/operator_notify.py). Without it, notifications queue to the file at
# $WORKSHOP_NOTIFY_FILE and a bridge picks them up.
DISCORD_BOT_TOKEN=
