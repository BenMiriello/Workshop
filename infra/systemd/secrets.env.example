# Workshop secrets — copy to ~/.config/workshop/secrets.env and fill in.
# `scripts/install_service.sh` copies this here (mode 0600) if it does not exist.
# Do NOT commit the filled-in copy. Everything here is OPTIONAL: the backend
# starts without it, but the corresponding features stay dormant.
#
# Auth that the backend reads directly from disk (NOT here) lives in
# ~/.config/clawdbot/: auth.env (CLAUDE_CODE_OAUTH_TOKEN, WORKSHOP_511_API_KEY),
# health-auth.env, owntracks-auth.env.

# Plaid (finance). PLAID_ENV must be sandbox, development, or production — it
# picks the Plaid API host. There is no default: if it's unset or misspelled,
# Plaid calls refuse rather than silently falling back to production.
# PLAID_ENV_URL overrides the host outright (custom/proxy endpoint) if you
# ever need one; leave it unset and PLAID_ENV decides.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_ENV_URL=

# BlueBubbles (iMessage)
BLUEBUBBLES_SERVER_URL=
BLUEBUBBLES_PASSWORD=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Open Wearables (auto-generated on deploy, fill after)
OPEN_WEARABLES_API_KEY=

# Postgres (Letta + Open Wearables, local)
POSTGRES_PASSWORD=

# Auto-PR: set to 1 to enable real `gh pr create`; default dry-run
WORKSHOP_AUTO_PR=0

# Commute: 511.org free developer token — https://511.org/open-data/token
# Without it the commute service runs but realtime transit delays are unobserved.
WORKSHOP_511_API_KEY=

# Discord bot token — lets the backend post commute alerts directly.
# Without it, alerts queue to notify-commute.txt.
DISCORD_BOT_TOKEN=

# Commute target channel — defaults to the operator's commute channel if unset.
WORKSHOP_COMMUTE_DISCORD_CHANNEL=
