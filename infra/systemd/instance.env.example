# Workshop instance identity — copy to ~/.config/workshop/instance.env
#
# This is the file that makes a clone YOURS. Nothing here may be committed:
# a fork is a different operator, a different domain, a different app roster,
# and different places on disk for an app's data.
#
# Loaded by the backend unit (EnvironmentFile) and by scripts/lib/instance.sh.
# Anything already exported in the environment wins over what is written here.

# --- who + where ------------------------------------------------------------
# How agents address you in prose. Unset reads as "the operator".
WORKSHOP_OPERATOR_NAME=

# The public hostname this instance serves through the tunnel, and the origin
# form of it. install_public_service.sh requires the first one.
WORKSHOP_PUBLIC_HOST=
WORKSHOP_PUBLIC_ORIGIN=

# The origin you actually browse on the LAN or tailnet, if different.
WORKSHOP_LOCAL_ORIGIN=

# cloudflared tunnel id — `cloudflared tunnel list`.
WORKSHOP_TUNNEL_ID=

# Port the public edge listens on (default 8002).
#WORKSHOP_EDGE_PORT=8002

# --- credentials living outside the repo ------------------------------------
# Subscription auth for spawned `claude` turns. Default ~/.config/workshop/auth.env.
#WORKSHOP_AUTH_ENV=
# Pin a specific claude binary; otherwise whatever is on PATH.
#WORKSHOP_CLAUDE_CLI=

# --- mobile builds ----------------------------------------------------------
# iOS bundle identifiers. Two variants can coexist on one device.
WORKSHOP_MOBILE_BUNDLE=
WORKSHOP_MOBILE_BUNDLE_ALT=
#WORKSHOP_MOBILE_NAME=Workshop
#WORKSHOP_MOBILE_SCHEME=workshop

# --- per-app data locations -------------------------------------------------
# Apps default to .runtime/apps/<app_id>/. Point them elsewhere when the data
# already lives outside the repo (a capture pipeline writing to its own disk,
# an existing database you do not want to move).
#BIRDNET_DB=
#BIRDNET_CLIPS=
#BIRDNET_BROWSER_DB=
#BIRDNET_CLIPS_DIR=
#BIRDNET_ATLAS_CLIPS_DIR=
#HEALTH_AUTH_ENV=
#OWNTRACKS_AUTH_ENV=

# --- notifications ----------------------------------------------------------
# Where agents queue lines for the operator, and where the chat bridge reads
# its credentials. Defaults: .runtime/notify.txt and ~/.config/workshop/discord.env.
#WORKSHOP_NOTIFY_FILE=
#WORKSHOP_DISCORD_ENV=
#WORKSHOP_COMMUTE_DISCORD_CHANNEL=
