# Workshop instance identity — copy to ~/.config/workshop/instance.env
#
# This is the file that makes a clone YOURS. Nothing here may be committed:
# a fork is a different operator, a different domain, a different app roster,
# and different places on disk for an app's data.
#
# Loaded by the backend unit (EnvironmentFile) and by scripts/lib/instance.sh.
# Anything already exported in the environment wins over what is written here.

# --- who + where ------------------------------------------------------------
# How agents address you in prose. Unset reads as "the operator".
WORKSHOP_OPERATOR_NAME=

# The public hostname this instance serves through the tunnel, and the origin
# form of it. install_public_service.sh requires the first one.
WORKSHOP_PUBLIC_HOST=
WORKSHOP_PUBLIC_ORIGIN=

# The origin you actually browse on the LAN or tailnet, if different.
WORKSHOP_LOCAL_ORIGIN=

# cloudflared tunnel id — `cloudflared tunnel list`.
WORKSHOP_TUNNEL_ID=

# Port the public edge listens on (default 8002).
#WORKSHOP_EDGE_PORT=8002

# --- credentials living outside the repo ------------------------------------
# Subscription auth for spawned `claude` turns. Default ~/.config/workshop/auth.env.
#WORKSHOP_AUTH_ENV=
# Pin a specific claude binary; otherwise whatever is on PATH.
#WORKSHOP_CLAUDE_CLI=

# --- who this deployment serves ---------------------------------------------
# single_operator (default) | multi_user
#
# This is a LICENSING switch, not a feature flag. A Claude subscription may only
# serve the person who bought it: Anthropic does not permit routing requests
# through Free/Pro/Max credentials on behalf of other users, and blocks it
# server side. In multi_user the subscription provider is refused in code and
# users must bring their own API keys.
#
# Anything unrecognised is treated as multi_user, so a typo fails safe.
# See docs/platform-redesign/model-access-and-byok-2026-08-11.md.
#WORKSHOP_DEPLOYMENT_MODE=single_operator

# Encryption at rest for the secrets store. Unset (the default) leaves it as
# plaintext at mode 0600, which is right for one person on their own machine.
# Set it before a second person's credentials share the store. 32 bytes, base64
# or hex:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes the stored secrets unreadable; they are not recoverable.
#WORKSHOP_SECRETS_KEK=

# --- mobile builds ----------------------------------------------------------
# iOS bundle identifiers. Two variants can coexist on one device.
WORKSHOP_MOBILE_BUNDLE=
WORKSHOP_MOBILE_BUNDLE_ALT=
#WORKSHOP_MOBILE_NAME=Workshop
#WORKSHOP_MOBILE_SCHEME=workshop

# --- per-app data locations -------------------------------------------------
# Apps default to .runtime/apps/<app_id>/. Point them elsewhere when the data
# already lives outside the repo (a capture pipeline writing to its own disk,
# an existing database you do not want to move).
#BIRDNET_DB=
#BIRDNET_CLIPS=
#BIRDNET_BROWSER_DB=
#BIRDNET_CLIPS_DIR=
#BIRDNET_ATLAS_CLIPS_DIR=
#HEALTH_AUTH_ENV=
#OWNTRACKS_AUTH_ENV=

# --- notifications ----------------------------------------------------------
# Where agents queue lines for the operator, and where the chat bridge reads
# its credentials. Defaults: .runtime/notify.txt and ~/.config/workshop/discord.env.
#WORKSHOP_NOTIFY_FILE=
#WORKSHOP_DISCORD_ENV=
#WORKSHOP_COMMUTE_DISCORD_CHANNEL=

# --- github -----------------------------------------------------------------
# The account this installation is allowed to work under. Set it, and the owner
# of every repo an agent touches is checked against it, so a clone cannot open
# pull requests against somebody else's account by inheriting a stale remote.
#WORKSHOP_GITHUB_OWNER=
# Owners this installation must never touch, comma-separated. Use it to fence
# off a work org from a personal one on a shared machine.
#WORKSHOP_BLOCKED_REPO_OWNERS=

# --- scoped execution ([SEC-A1]; see docs/platform-redesign/managed-file-refer
# ences-and-path-scoping-2026-08-18.md) ---------------------------------------
# Layer 1: every turn with a cwd (a build/dev turn) runs inside a bwrap
# filesystem view confined to its scope. Confined by DEFAULT wherever bwrap can
# make a user namespace -- leave unset. =0 is the escape hatch (off entirely);
# =1 forces it on even if the functional probe would say no.
#WORKSHOP_SCOPED_EXEC=
# The uid layer, composed on top of Layer 1: run the confined turn as this
# dedicated system account instead of the service's own user, so an escape from
# the filesystem view still cannot reach this account's OAuth token, docker
# socket, or other owners' data. Unset = off (the default). Setting it to an
# account that does not exist, or before `scripts/setup_turn_user.sh` has been
# run as root, makes every scoped turn FAIL rather than silently run
# unisolated -- that is deliberate, see services/scoped_exec.py's module
# docstring. A turn scoped to this platform's own repo is exempt even when this
# is set (systemctl --user cannot cross a uid boundary, and apply.sh needs it).
#WORKSHOP_TURN_USER=

# --- developer mode ---------------------------------------------------------
# 1 lets agent runs target the Workshop's OWN source tree. Off by default, and
# off is right for every deployment that is running the app rather than building
# it. This is a product capability boundary and a safety interlock, not a
# security boundary: anyone with a shell here can edit the source regardless.
# See docs/decisions/0014-developer-mode-gates-the-resolved-directory.md.
#WORKSHOP_DEV_MODE=0

# --- agent concurrency ------------------------------------------------------
# How many model processes may run at once. Each agent turn is a whole OS
# process, so these bound the machine. Normally set from Settings and stored in
# .runtime/agent-concurrency.json; set here to PIN a value the UI cannot then
# contradict. Defaults: 8 turns, 4 background calls.
#WORKSHOP_MAX_CONCURRENT_TURNS=
#WORKSHOP_MAX_CONCURRENT_HELPERS=

# --- letta ------------------------------------------------------------------
# Which agents may call the Letta tool bridge, comma-separated. Empty disables it.
#WORKSHOP_LETTA_TOOL_AGENTS=
# The Letta instance to talk to. IMPORTANT on a shared host: the default port
# belongs to whichever tenant started first, so an unset value here can silently
# read another installation's database. Set it explicitly or leave Letta unused.
#LETTA_URL=
