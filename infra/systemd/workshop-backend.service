# Workshop FastAPI backend — systemd --user unit (template).
#
# Do NOT copy this file into ~/.config/systemd/user/ by hand: the
# @WORKSHOP_ROOT@ token below is a placeholder. Run
#   bash scripts/install_service.sh
# which substitutes the real checkout path and installs/enables the unit.
#
# Portable by design: %h resolves to the invoking user's home, so this works
# for any user and any clone location. Nothing about a particular deployment
# (hostname, operator name, where an app's data lives) belongs in this file —
# that goes in ~/.config/workshop/instance.env, loaded below.

[Unit]
Description=Workshop FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Kill ONLY uvicorn on stop/restart — not the whole cgroup.
#
# A chat turn runs a detached `claude` child that streams its output to a
# journal file, so the turn survives a backend restart: the next backend tails
# that journal and drives the turn to completion (build_streaming.py,
# "Crash/restart resilience"). start_new_session=True gives the child its own
# session + process group, but cgroup membership is INHERITED and unaffected —
# so under systemd's default KillMode=control-group every restart SIGTERMed the
# turn as well, and the design never actually held. The operator saw this on
# 2026-07-30: a reply in flight collapsed to whatever partial text had been
# flushed, then finalized as lost.
#
# KillMode=process signals the main process only, leaving in-flight turns to
# finish and be re-adopted. The tradeoff is that a stopped service can leave a
# child running for the length of one turn; that is the intended behaviour here.
KillMode=process
WorkingDirectory=@WORKSHOP_ROOT@/backend
# Optional secrets (Plaid, 511, Discord, etc.) and this deployment's identity
# and data locations. The leading "-" makes each non-fatal when absent. See
# infra/systemd/secrets.env.example and instance.env.example.
EnvironmentFile=-%h/.config/workshop/secrets.env
EnvironmentFile=-%h/.config/workshop/instance.env
Environment=WORKSHOP_ROOT=@WORKSHOP_ROOT@
Environment=LETTA_URL=http://127.0.0.1:8283
Environment=LETTA_SERVER_PASS=workshop-local
# Rootless docker, so the app runner can manage container apps. %t is the user's
# runtime dir, which is how this stays correct for any uid instead of pinning
# one. Harmless when docker is absent: container_runtime falls back.
Environment=DOCKER_HOST=unix://%t/docker.sock
# LOOPBACK ONLY, deliberately.
#
# This served 0.0.0.0 for months. Nothing sits in front of the backend enforcing
# a boundary: the public edge is a separate process on :8002 that proxies here,
# not a gateway this hides behind. So a non-loopback bind puts the finance,
# health, location and chat APIs on every interface the host has, reachable by
# anything on the LAN. The same mistake was made once on the vite dev server and
# is recorded in frontend/vite.config.ts.
#
# Remote access is loopback-originating by design: tailscale serve and
# cloudflared both connect to 127.0.0.1. If a deployment genuinely needs another
# bind address, change it here deliberately rather than shipping it as a default
# nobody chose.
#
# --timeout-graceful-shutdown: uvicorn defaults to waiting FOREVER for open
# connections. The chat SSE streams end only when their turn does, so a single
# open browser tab held a restart until TimeoutStopSec expired and systemd sent
# SIGKILL -- 90 seconds of dead backend for a 3-second restart. The streams now
# release themselves on shutdown (build_streaming.SHUTTING_DOWN); this is the
# cap for any long-lived response that does not.
ExecStart=@WORKSHOP_ROOT@/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 10
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
