# Cloudflare tunnel runner — systemd --user unit (template).
#
# Runs whichever tunnel ~/.cloudflared/config.yml points at. The hostnames and
# the tunnel id are this deployment's, not the platform's: they live in
# ~/.config/workshop/instance.env (WORKSHOP_PUBLIC_HOST, WORKSHOP_TUNNEL_ID) and
# are written into the cloudflared config by scripts/install_public_service.sh.
#
# Before first start, create the DNS record once:
#   cloudflared tunnel route dns "$WORKSHOP_TUNNEL_ID" "$WORKSHOP_PUBLIC_HOST"
# (the egress guard blocks that API call from an agent shell).
[Unit]
Description=Cloudflare tunnel
After=network-online.target workshop-public.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/bin/cloudflared tunnel --config %h/.cloudflared/config.yml run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
