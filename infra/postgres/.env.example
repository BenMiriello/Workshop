# Copy to .env (gitignored) and set a real password before first start.
# The backend reads the assembled URL from WORKSHOP_DATABASE_URL in
# ~/.config/workshop/secrets.env, not from this file.
POSTGRES_PASSWORD=change-me

# Only when another installation already runs this compose on the same Docker
# host: the container name, the loopback port, and the compose project name
# (which prefixes the data volume) must all differ from the other one's.
# Point WORKSHOP_DATABASE_URL at the port you choose.
#WORKSHOP_DB_CONTAINER=workshop-db
#WORKSHOP_DB_PORT=5440
#COMPOSE_PROJECT_NAME=postgres
