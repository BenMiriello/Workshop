{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/done.sh\" --stop-hook",
            "timeout": 30,
            "statusMessage": "starting the completion check in the background"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/done.sh\" --prompt-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
