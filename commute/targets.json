{
  "policy": {
    "flex_minutes_late": 15,
    "alert_only_when": "late_risk",
    "never_alert_when": ["early", "on_time_low_confidence"],
    "per_leg_alert_cooldown_hours": 24,
    "emergency_research_triggers": [
      "line_shutdown",
      "missed_train_no_recovery",
      "predicted_delay_over_30min"
    ]
  },
  "targets": [
    {
      "schedule_id": "weekday-am",
      "arrive_by": "09:00",
      "hard_deadline": null
    },
    {
      "schedule_id": "weekday-pm",
      "arrive_by": "19:45",
      "hard_deadline": null
    }
  ]
}
