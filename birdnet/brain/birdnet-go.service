# BirdNET-Go on the Debian box (the Brain). Install to /etc/systemd/system/
# or run as a user unit. Pulls the Pi's RTSP stream, runs detection 24/7, owns
# the SQLite DB and exported clips, serves the stock dashboard on :8080.
#
#   sudo cp birdnet-go.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now birdnet-go
#
# Runs as clawd-a so the SQLite DB and clips are owned by the same user the
# Workshop backend runs as (read access with no sudo, no perms juggling).

[Unit]
Description=BirdNET-Go realtime bird sound analyzer
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=clawd-a
Group=clawd-a
# Lat/long + Pi host come from here, kept out of git.
EnvironmentFile=/home/clawd-a/workshop/birdnet/brain/secrets.env
ExecStart=/usr/local/bin/birdnet-go realtime --config /home/clawd-a/birdnet/config.yaml
Restart=always
RestartSec=10
# Reconnect to a flapping RTSP source instead of dying; BirdNET-Go retries the
# stream internally, and Restart=always covers a hard crash.
WatchdogSec=0

[Install]
WantedBy=multi-user.target
