# Copy to brain/secrets.env (git ignored) and fill in. Loaded by the systemd
# unit via EnvironmentFile. Never commit the real values.
#
# Operator's yard coordinates for the BirdNET range filter. Keep these OUT of
# git and OUT of any public artifact. The sanitizing publish job never reads
# them and the public dataset never contains them.
BIRDNET_LATITUDE=00.0000
BIRDNET_LONGITUDE=000.0000

# Tailscale MagicDNS host (or 100.x CGNAT IP) of the Pi capture node.
PI_TAILSCALE_HOST=birdpi.tailXXXXXX.ts.net
