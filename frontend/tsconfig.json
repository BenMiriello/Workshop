{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"],
      // One entry per subpath in packages/ui/package.json "exports" — no
      // wildcard, so tsc rejects a reach into the kit's internals exactly the
      // way the Vite alias and a published package both would.
      "@workshop/ui": ["../packages/ui/src/index.ts"],
      "@workshop/ui/map": ["../packages/ui/src/Map.tsx"],
      "@workshop/ui/markdown": ["../packages/ui/src/Markdown.tsx"],
      "@workshop/ui/tokens.js": ["../packages/ui/src/styles/tokens.js"]
    }
  },
  "include": ["src", "../shared", "../packages/ui/src"]
}
