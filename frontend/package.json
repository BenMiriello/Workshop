{
  "name": "workshop-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "bash ../scripts/stamp_build.sh --capture",
    "build": "tsc -b && vite build",
    "postbuild": "bash ../scripts/stamp_build.sh --write",
    "preview": "vite preview",
    "gen:tokens": "npm run gen:tokens --workspace @workshop/ui",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.102.4",
    "@workshop/ui": "^0.6.0",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.24.0",
    "mermaid": "^11.17.2",
    "pmtiles": "^4.4.1",
    "protomaps-themes-base": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
