# RTSP capture+publish on the Pi. Install to /etc/systemd/system/.
#
#   sudo cp mediamtx.service /etc/systemd/system/
#   sudo cp mediamtx.yml /etc/mediamtx/mediamtx.yml
#   sudo systemctl daemon-reload && sudo systemctl enable --now mediamtx
#
# Auto-recovers on reboot (WantedBy) and on crash (Restart=always). ffmpeg is
# supervised by mediamtx itself (runOnInitRestart), so a USB/ALSA blip restarts
# capture without restarting the whole service.

[Unit]
Description=mediamtx RTSP server (yard mic -> tailnet)
After=network-online.target sound.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Confirm the card's ALSA address with `arecord -l` after the sound card
# enumerates. Common values: plughw:1,0 (first USB card) or plughw:CARD=Device,DEV=0.
Environment=MTX_ALSA_DEVICE=plughw:1,0
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/mediamtx.yml
Restart=always
RestartSec=5
# Audio device access.
SupplementaryGroups=audio

[Install]
WantedBy=multi-user.target
