# Mobile app backend override (dev). Copy to .env.local (gitignored) and set the
# URL of the Workshop backend you want the phone to use. Omit entirely to use the
# operator's public deployment (the default in native/config.ts).
#
# Example: point at the tailnet during Mac bring-up (requires Tailscale on the phone).
# The origin's /api is proxied to the backend (vite in dev), so this one URL
# serves both the WebView and the native producers.
# EXPO_PUBLIC_WORKSHOP_URL=https://your-host.example.com
