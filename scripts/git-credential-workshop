#!/bin/sh
# git credential helper: answer github.com from the connected account.
#
# `git config --global credential.https://github.com.helper` points here once the
# operator connects a GitHub account in Settings. Everything a shell on this host
# pushes then authenticates from that one credential, which is the whole point:
# before this existed, `git push` in an agent session died with
# "could not read Username for 'https://github.com'" and there was no in-app way
# to fix it.
#
# It runs on git's own timing, several times per push, and must work when the
# backend is down, so it is a direct read of the owner's store rather than an
# HTTP call. The backend virtualenv is used explicitly because the store may be
# encrypted and decrypting it needs `cryptography`.
#
# git speaks this protocol on stdin/stdout as key=value lines. Only `get` is
# answered; `store` and `erase` are no-ops, because this helper does not own a
# cache to write to and must never delete the operator's connection because a
# push was rejected.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
ROOT=$(dirname -- "$HERE")
PY="$ROOT/backend/.venv/bin/python3"
[ -x "$PY" ] || PY=python3

exec "$PY" "$ROOT/scripts/git_credential_workshop.py" "$@"
